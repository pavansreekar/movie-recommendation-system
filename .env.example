# ── Required ──────────────────────────────────────────────────────────────────
# Get a free key at https://developer.themoviedb.org/docs/getting-started
TMDB_API_KEY=your_tmdb_v3_api_key_here

# Optional: which TMDB hostname to try first. Some networks (several Indian ISPs) block
# api.themoviedb.org; the app then switches to api.tmdb.org by itself — same API, same
# key, no VPN needed. Setting this just skips the first slow attempt after each restart.
# TMDB_API_HOST=api.tmdb.org

# Groq — powers the in-app chat assistant (free tier). Without it the chat falls
# back to keyword matching. Optional overrides if Groq retires a model:
#   GROQ_MODEL=openai/gpt-oss-120b   GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# ── Database (production) ─────────────────────────────────────────────────────
# PostgreSQL connection string — required in production to persist data across deploys.
# Get a free database at https://neon.tech  (New project → Connection string)
# Leave blank for local development (SQLite is used automatically).
DATABASE_URL=

# ── Flask ─────────────────────────────────────────────────────────────────────
# Change to a long random string in production: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=dev-secret-change-me-in-production

# ── CORS / origins ────────────────────────────────────────────────────────────
# Comma-separated list of origins allowed to call the Flask API
# In production add your Vercel URL, e.g. https://your-app.vercel.app
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Next.js → Flask proxy ─────────────────────────────────────────────────────
# Used by next.config.mjs rewrites; set to your Render/Railway backend URL in prod
BACKEND_ORIGIN=http://localhost:5001

# ── TMDB tuning (optional) ────────────────────────────────────────────────────
TMDB_TIMEOUT_SECONDS=5
TMDB_MAX_RETRIES=2
